# Copy to .env and fill in.
DATABASE_URL=postgres://gripsou:gripsou@localhost:5432/gripsou

# Where the backend serves the built SPA from.
STATIC_DIR=frontend/dist

# Address the API binds to.
BIND_ADDR=0.0.0.0:8080

# Public hostname Caddy terminates TLS for, e.g. finance.example.com (real
# Let's Encrypt cert). Leave unset to default to "localhost" (self-signed).
SITE_ADDRESS=

# Optional: tracing filter (e.g. info, gripsou=debug). Defaults to "info".
RUST_LOG=info

# Encryption key
ENCRYPTION_KEY=

# HS256 signing secret for auth bearer tokens (any long random string).
AUTH_SECRET=

# Powens provider credentials
POWENS_CLIENT_ID=
POWENS_CLIENT_SECRET=
POWENS_DOMAIN=
