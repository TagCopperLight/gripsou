# Copy to .env at the repo root. The backend (run from backend/) loads it via
# dotenvy's parent-directory search. Docker injects its own env, so these files
# are for local dev only.

# --- Required ---
DATABASE_URL=postgres://gripsou:gripsou@localhost:5432/gripsou

# --- Optional (have code defaults) ---
# RUST_LOG=info                 # tracing filter
# STATIC_DIR / BIND_ADDR also exist but Docker sets them; defaults are fine elsewhere.

# --- Powens provider (required when using Powens) ---
# ENCRYPTION_KEY=              # openssl rand -hex 32
# POWENS_CLIENT_ID=
# POWENS_CLIENT_SECRET=
# POWENS_DOMAIN=               # e.g. myapp.biapi.pro
# POWENS_REDIRECT_URI=         # e.g. http://localhost:5173/connections/callback
# POWENS_WEBHOOK_SECRET=       # Optional: enables Powens webhook-driven sync. Leave unset to use polling/direct fetch only. Set to the HMAC secret from the Powens hmac_signature auth provider.

# --- Logo companies API
# BRANDFETCH_CLIENT_ID=