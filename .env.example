# Copy to .env at the repo root. `cargo run` (from backend/) finds it by
# searching parent directories, and the compose backend reads it too, with its
# own DATABASE_URL.

# --- Required ---
# The compose postgres publishes no port. From the host, use its container address:
#   docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' gripsou-postgres-1
DATABASE_URL=postgres://gripsou:gripsou@<postgres-container-address>:5432/gripsou
ENCRYPTION_KEY=                 # openssl rand -hex 32; encrypts provider credentials and two-factor secrets. The server refuses to start without a valid one.
PUBLIC_URL=http://localhost:5173 # the address the browser opens gripsou at: http://localhost:5173 with `bun run dev`, the reverse proxy's https://… address with the compose stack. Passkeys are bound to it: changing it makes every saved passkey stop working. The server refuses to start without it.

# --- Optional (have code defaults) ---
# RUST_LOG=info                 # tracing filter
# The image sets these two. In development vite serves the SPA.
# STATIC_DIR=frontend/dist      # the built SPA
# BIND_ADDR=0.0.0.0:8080
