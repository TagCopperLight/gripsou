<svg viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <style>
      @font-face {
        font-family: 'Unbounded Local';
        src: url(data:font/woff2;base64,) format('woff2');
        font-weight: 600;
        font-style: normal;
      }
      text {
        font-family: 'Unbounded Local', sans-serif;
        font-weight: 600;
        fill: #f4f1ef;
        font-size: 160px;
      }
    </style>
  </defs>
  <rect width="256" height="256" rx="64" fill="#13110f" />
  <!-- y=118 shifts the 'g' up so the whole bounding box (including descender) is centered, rather than the loop -->
  <text x="128" y="118" dominant-baseline="middle" text-anchor="middle">g</text>
</svg>