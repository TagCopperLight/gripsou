{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "primary",
    "companions",
    "minimum_samples",
    "required_runs",
    "max_noise_percent",
    "allow_environment_differences"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "primary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metric",
        "min_improvement_percent"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "metric": {
          "enum": [
            "median_ms",
            "p95_ms"
          ]
        },
        "min_improvement_percent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      }
    },
    "companions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "metric",
          "max_regression_percent"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "metric": {
            "enum": [
              "median_ms",
              "p95_ms"
            ]
          },
          "max_regression_percent": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "minimum_samples": {
      "type": "integer",
      "minimum": 30
    },
    "required_runs": {
      "const": 3
    },
    "max_noise_percent": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "allow_environment_differences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
