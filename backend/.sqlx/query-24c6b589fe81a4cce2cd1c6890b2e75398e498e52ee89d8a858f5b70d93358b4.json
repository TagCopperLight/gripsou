  "query": "\n        select p.key          as \"key!\",\n               p.display_name as \"display_name!\",\n               p.description\n        from provider p\n        cross join app_settings s\n        where s.id = 1\n          and p.kind = 'account'\n          and p.key = any(s.enabled_providers)\n        order by p.display_name\n        ",
