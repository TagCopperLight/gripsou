{
  "db_name": "PostgreSQL",
  "query": "\n        select p.key                              as \"key!\",\n               p.display_name                     as \"display_name!\",\n               p.description                      as \"description\",\n               (p.key = any(s.enabled_providers)) as \"enabled!\"\n        from provider p\n        cross join app_settings s\n        where s.id = 1 and p.kind = 'account' and p.enabled = true and p.key = $1\n        ",
