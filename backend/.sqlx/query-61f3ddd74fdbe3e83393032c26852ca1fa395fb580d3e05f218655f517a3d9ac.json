{
  "db_name": "PostgreSQL",
  "query": "\n        select distinct\n               i.id       as \"id!\",\n               i.kind     as \"kind!\",\n               i.symbol,\n               i.isin,\n               i.name     as \"name!\",\n               i.currency as \"currency!\",\n               i.meta     as \"meta!\"\n        from holding h\n        join account a    on a.id = h.account_id\n        join instrument i on i.id = h.instrument_id\n        where a.connection_id = $1\n          and i.kind <> 'cash'\n          and h.quantity <> 0\n        order by i.name\n        ",
