  "query": "\n        select t.category_source, t.category_reviewed_at, t.transfer_pair_id\n        from transaction t\n        join account a on a.id = t.account_id\n        join connection k on k.id = a.connection_id\n        where t.id = $1 and k.user_id = $2\n        ",
