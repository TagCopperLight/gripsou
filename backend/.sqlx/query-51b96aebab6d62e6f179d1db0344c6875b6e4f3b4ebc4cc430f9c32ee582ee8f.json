{
  "db_name": "PostgreSQL",
  "query": "\n        select model,\n               count(*) as \"runs!\",\n               count(*) filter (where tokens_in is null or tokens_out is null) as \"runs_without_usage!\",\n               coalesce(sum(tokens_in), 0)::bigint as \"tokens_in!\",\n               coalesce(sum(tokens_out), 0)::bigint as \"tokens_out!\"\n        from budget_ai_run\n        group by model\n        order by model\n        ",
