  "query": "\n        select g.id   as \"id!\",\n               g.name as \"name!\",\n               g.color,\n               (select count(*) from budget_transaction_tag tt where tt.tag_id = g.id) as \"tx_count!\"\n        from budget_tag g\n        where g.user_id = $1\n        order by g.created_at, g.name\n        ",
