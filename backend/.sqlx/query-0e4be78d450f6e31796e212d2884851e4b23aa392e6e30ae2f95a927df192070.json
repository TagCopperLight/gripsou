  "query": "\n        select t.id as \"id!\", (t.transfer_pair_id is not null) as \"paired!\"\n        from transaction t\n        where t.id = any($1)\n          and t.id in (select id from user_transactions($2))\n        order by t.id\n        for update of t\n        ",
