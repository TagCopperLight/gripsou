{
  "db_name": "PostgreSQL",
  "query": "\n        select c.id           as \"id!\",\n               c.provider_key  as \"provider_key!\",\n               p.display_name  as \"provider_name!\",\n               c.display_name  as \"display_name!\",\n               c.institution_name,\n               c.status        as \"status!\",\n               c.last_sync_at,\n               c.last_error\n        from connection c\n        join provider p on p.key = c.provider_key\n        where c.user_id = $1\n        order by p.display_name, c.display_name, c.id\n        ",
