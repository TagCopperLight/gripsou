{
  "db_name": "PostgreSQL",
  "query": "\n        select tt.transaction_id as \"transaction_id!\",\n               g.id   as \"id!\",\n               g.name as \"name!\",\n               g.color\n        from budget_transaction_tag tt\n        join budget_tag g on g.id = tt.tag_id\n        where tt.transaction_id = any($1)\n          and g.user_id = $2\n        order by g.created_at, g.name, g.id\n        ",
