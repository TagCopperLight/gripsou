{
  "db_name": "PostgreSQL",
  "query": "\n        update account a\n           set name = $3, type_key = $4, color = $5\n          from connection c, account_type t\n         where a.id = $1 and a.connection_id = c.id and c.user_id = $2\n           and t.key = $4\n        returning a.id      as \"id!\",\n                  a.name    as \"name!\",\n                  a.color,\n                  a.type_key as \"type_key!\",\n                  t.label    as \"type_label!\"\n        ",
