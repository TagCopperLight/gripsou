{
  "db_name": "PostgreSQL",
  "query": "\n        update connection\n           set status = 'syncing', sync_started_at = now()\n         where id = $1 and user_id = $2\n           and (status <> 'syncing'\n                or sync_started_at is null\n                or sync_started_at < now() - make_interval(mins => $3))\n        returning id as \"id!\", status as \"status!\", last_sync_at, last_error\n        ",
