{
  "db_name": "PostgreSQL",
  "query": "\n        select h.id as \"id!\", h.account_id as \"account_id!\", a.currency as \"account_currency!\"\n        from holding h\n        join account a    on a.id = h.account_id\n        join connection c on c.id = a.connection_id\n        where h.id = $1 and c.user_id = $2\n        ",
